# ==============================================================================
# FINANCIAL RESILIENCE ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Financial Resilience Engine"
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-use-a-32-byte-cryptographically-secure-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (Tiger Cloud or local TimescaleDB)
# For Tiger Cloud, paste the service URI from Tiger Console here. Keep its
# sslmode=require query parameter if it is present in the supplied URI.
# Standard postgresql:// and postgres:// URLs are supported.
# Local Docker default:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/financial_resilience
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
# Only applies to localhost/127.0.0.1/::1; cloud URLs never silently switch to SQLite.
USE_LOCAL_FALLBACK_DB=true

# Redis & Caching
REDIS_URL=redis://localhost:6379/0

# Message Broker (RabbitMQ / Celery)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI Orchestration (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3

# External Voice (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# External Data Sources
STATSCAN_API_BASE_URL=https://www150.statcan.gc.ca/t1/wds/rest
BANKING_PROVIDER_MOCK_MODE=true

# Optional application-owned provider adapters (see docs/INTEGRATIONS.md).
# Missing settings report unavailable; BANKING_PROVIDER_MOCK_MODE does not fabricate data.
BANKING_API_URL=
BANKING_API_KEY=
UNDERWRITING_API_URL=
UNDERWRITING_API_KEY=
BROWSING_API_URL=
BROWSING_API_KEY=
NOTIFICATION_API_URL=
NOTIFICATION_API_KEY=
INTEGRATION_TIMEOUT_SECONDS=20
INTEGRATION_RETRIES=2

# Approved lending terms are required before alternative offers can be generated.
# Leave unset until business terms are supplied (do not set empty numeric values).
# INSTALLMENT_ANNUAL_RATE=12
# INSTALLMENT_FEE=0
ELEVENLABS_EMPATHETIC_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
STATSCAN_CPI_VECTOR=41690973
ENABLE_BACKGROUND_JOBS=true
JOB_INTERVAL_SECONDS=3600
FRAUD_NEW_MERCHANT=0.50
FRAUD_FAMILIAR_MERCHANT=0.50
FRAUD_RECURRING_MULTIPLIER=0.90
FRAUD_BROWSING_REDUCTION=0.15
FRAUD_CHARGEBACK_INCREMENT=0.10
FRAUD_GEOGRAPHY_INCREMENT=0.25
FRAUD_BUDGET_INCREMENT=0.10
FRAUD_REVIEW_THRESHOLD=0.85
FRAUD_Z_THRESHOLD=3.0

# Security & Compliance
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]
LOG_LEVEL=INFO
LOG_FORMAT=json
# Generated summaries (including audio): 0 keeps them until user deletion.
# Positive values enable age-based deletion by the background worker.
SUMMARY_RETENTION_DAYS=0
# Source lookup is public and read-only; public user registration is disabled.
ENABLE_REGISTRATION=false
